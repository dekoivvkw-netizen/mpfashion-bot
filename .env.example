# Environment variables for MP Fashion Bot
# Copy this file to .env and replace the placeholders.

# Shopify
SHOPIFY_STORE=zg1yry-ep
SHOPIFY_STORE_URL=https://zg1yry-ep.myshopify.com
# Use the Shopify Admin API access token generated in Shopify Admin > Apps > Develop apps > API credentials
SHOPIFY_TOKEN=YOUR_ADMIN_API_ACCESS_TOKEN
SHOPIFY_ACCESS_TOKEN=YOUR_ADMIN_API_ACCESS_TOKEN

# Optional: used only if your app is configured with OAuth instead of a fixed token
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Runtime
MODE=bot
BOT_ENABLED=1
MAX_PER_RUN=10
MIN_DISCOUNT=30
MIN_MARGIN=0.25
MARKUP=1.35
VAT=0.22
SHIPPING_COST=4.00
PAYMENT_FEE_PCT=0.03
PAYMENT_FEE_FIX=0.25

# BigBuy
BIGBUY_KEY=
BIGBUY_TAXONOMY=
BIGBUY_SANDBOX=0

# Optional notifications
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514

# Optional feed alternative
FEED_URL=
